# --- Node / PWA client ---
node_modules/
dist/
build/
.env
.env.local
.env.*.local
*.log
npm-debug.log*
.cache/
.parcel-cache/

# --- Python / procesamiento de imagen y backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
*.ipynb_checkpoints

# --- Datasets e imágenes de campo (no versionar fotos crudas) ---
# Las fotos del dataset viven en almacenamiento compartido (Drive), no en git.
/dataset-fotos/
*.jpg
*.jpeg
*.png
!docs/**/*.png
# Los iconos de la aplicación son código, no fotos de campo: sin ellos el manifest de la PWA
# apunta a archivos que no existen y el navegador deja de ofrecer la instalación, sin que
# nada falle de forma visible.
!client/public/*.png
!docs/**/*.jpg

# --- Base de datos ---
*.sqlite3
*.bak

# --- Respaldos (T-29): viven en almacenamiento compartido, no en git ---
database/backups/*.dump
database/backups/*.sql
!database/backups/.gitkeep

# --- Credenciales y secretos ---
*.pem
*.key
secrets.json
credentials.json

# --- Sistema operativo / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
